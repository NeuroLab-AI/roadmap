{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurolab-ai.github.io/roadmap/publication/public-roadmap.schema.json",
  "title": "NeuroLab Public Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publication", "categories"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version", "status"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["draft", "review", "published"]
        },
        "releasedOn": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "nullableText": {
      "type": ["string", "null"]
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentFoundation": {
          "$ref": "#/$defs/nullableText"
        },
        "primaryUserValue": {
          "$ref": "#/$defs/nullableText"
        },
        "dependencies": {
          "$ref": "#/$defs/nullableText"
        },
        "validationGate": {
          "$ref": "#/$defs/nullableText"
        },
        "claimBoundary": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcome",
        "order",
        "visibility",
        "details"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,4}-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "visibility": {
          "enum": ["primary", "supporting", "details-only"]
        },
        "phase": {
          "type": ["string", "null"]
        },
        "maturity": {
          "$ref": "#/$defs/nullableText"
        },
        "confidence": {
          "$ref": "#/$defs/nullableText"
        },
        "horizon": {
          "$ref": "#/$defs/nullableText"
        },
        "status": {
          "$ref": "#/$defs/nullableText"
        },
        "details": {
          "$ref": "#/$defs/details"
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order", "initiatives"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "initiatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/initiative"
          }
        }
      }
    }
  }
}
