{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurolab-ai.github.io/roadmap/publication/public-roadmap.schema.json",
  "title": "NeuroLab Public Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publication", "stages", "categories", "initiatives"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.0.0" },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version", "status", "releasedOn"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "review", "published"] },
        "releasedOn": { "type": ["string", "null"], "format": "date" }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "initiatives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/initiative" }
    }
  },
  "$defs": {
    "nullableText": { "type": ["string", "null"] },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "abbreviation", "visualToken", "order"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "abbreviation": { "type": "string", "minLength": 1 },
        "visualToken": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "order": { "type": "integer", "minimum": 1 }
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentFoundation": { "$ref": "#/$defs/nullableText" },
        "primaryUserValue": { "$ref": "#/$defs/nullableText" },
        "dependencies": { "$ref": "#/$defs/nullableText" },
        "validationGate": { "$ref": "#/$defs/nullableText" },
        "claimBoundary": { "$ref": "#/$defs/nullableText" }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "categoryId",
        "sequence",
        "stage",
        "visibility",
        "title",
        "outcome",
        "maturity",
        "confidence",
        "horizon",
        "details"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{2}$" },
        "categoryId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "stage": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "visibility": { "enum": ["primary", "supporting", "details-only"] },
        "title": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "maturity": { "$ref": "#/$defs/nullableText" },
        "confidence": { "$ref": "#/$defs/nullableText" },
        "horizon": { "$ref": "#/$defs/nullableText" },
        "details": { "$ref": "#/$defs/details" }
      }
    }
  }
}
